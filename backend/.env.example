# Copy to .env (or export) — no secrets are needed.
# Path to the trained checkpoint (default: backend/models/foresight_vit.pt)
FORESIGHT_MODEL_PATH=models/foresight_vit.pt
# Optional held-out metrics JSON shown on /api/models and the About page
FORESIGHT_MODEL_METRICS_PATH=models/foresight_vit_test_metrics.json
FORESIGHT_DB_PATH=foresight.db
# auto | cpu | mps | cuda
FORESIGHT_DEVICE=auto
FORESIGHT_MAX_UPLOAD_MB=15
# Comma-separated list of allowed frontend origins
FORESIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# UI-development only. Leave 0: when 1, results are random and labelled DEMO MOCK DATA.
FORESIGHT_MOCK_MODE=0
FORESIGHT_INFERENCE_TIMEOUT_S=30
